{
	"name": "pi-dock",
	"version": "0.1.0",
	"private": true,
	"description": "A thin local web UI for the Pi coding agent",
	"type": "module",
	"bin": {
		"pi-dock": "bin/pi-dock.js"
	},
	"files": [
		"bin",
		"src",
		"public",
		"extension",
		"scripts",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"start": "node bin/pi-dock.js",
		"test": "playwright test",
		"smoke": "node scripts/smoke-real.mjs",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"typecheck": "tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@playwright/test": "1.48.1",
		"@types/node": "^22.20.5",
		"typescript": "^5.9.3"
	},
	"keywords": [
		"pi",
		"coding-agent",
		"web-ui",
		"local-first"
	],
	"license": "MIT"
}
