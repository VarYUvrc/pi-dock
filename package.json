{
	"name": "pi-tinychat",
	"version": "0.1.0",
	"description": "A tiny local web UI for the Pi coding agent with a live plan panel and context compaction presets.",
	"type": "module",
	"bin": {
		"pi-tinychat": "bin/pi-tinychat.js"
	},
	"files": [
		"bin",
		"src",
		"public",
		"extension",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"start": "node bin/pi-tinychat.js",
		"test": "playwright test",
		"test:pi": "node test/integration/real-pi.mjs",
		"smoke": "node scripts/smoke-real.mjs",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.extension.json",
		"check:i18n": "node scripts/check-i18n.mjs",
		"pack:check": "node scripts/check-pack.mjs",
		"check": "npm run lint && npm run typecheck && npm run check:i18n && npm test && npm run pack:check",
		"verify": "npm run lint && npm run typecheck && npm run check:i18n && npm run test:pi && npm run pack:check",
		"prepublishOnly": "npm run verify"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VarYUvrc/pi-tinychat.git"
	},
	"homepage": "https://github.com/VarYUvrc/pi-tinychat#readme",
	"bugs": {
		"url": "https://github.com/VarYUvrc/pi-tinychat/issues"
	},
	"author": "VarYUvrc",
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@playwright/test": "1.48.1",
		"@types/node": "^22.20.5",
		"typebox": "1.3.27",
		"typescript": "^5.9.3"
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-coding-agent",
		"coding-agent",
		"web-ui",
		"local-first",
		"plan",
		"compaction",
		"tinychat"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	}
}
