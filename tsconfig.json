{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],
		"skipLibCheck": true,
		// Dock only needs shape checks on the Pi boundary, not null/any rigor
		// across the whole runtime. Keep the bar low so JSDoc stays sparse.
		"strict": false,
		"noImplicitAny": false
	},
	"include": ["bin/**/*.js", "src/**/*.js", "src/**/*.d.ts", "test/fixtures/**/*.js"],
	"exclude": ["node_modules", "tmp", "test-results", "playwright-report"]
}
